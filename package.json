{
  "name": "dev-interview-challenge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dev-interview-challenge/api --filter @dev-interview-challenge/ui dev",
    "dev:api": "pnpm --filter @dev-interview-challenge/api dev",
    "dev:ui": "pnpm --filter @dev-interview-challenge/ui dev",
    "build": "pnpm --filter @dev-interview-challenge/ui build",
    "start": "pnpm --parallel --filter @dev-interview-challenge/api --filter @dev-interview-challenge/ui start",
    "lint": "pnpm --filter @dev-interview-challenge/ui lint",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive typecheck",
    "test:api": "pnpm --filter @dev-interview-challenge/api test",
    "test:ui": "pnpm --filter @dev-interview-challenge/ui test"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
